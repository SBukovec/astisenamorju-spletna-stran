<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <DefaultItemExcludes>$(DefaultItemExcludes);Program/**</DefaultItemExcludes>
    <RootNamespace>AstisenamorjuUrejevalnik</RootNamespace>
    <StartupObject>AstisenamorjuUrejevalnik.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <ApplicationIcon>AstisenamorjuUrejevalnik.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="AstisenamorjuUrejevalnik.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWithSourceToPublish" AfterTargets="Publish">
    <Copy SourceFiles="AstisenamorjuUrejevalnik.vbproj;MainForm.vb;Program.vb;SiteContent.vb;SeoExporter.vb;NuGet.Config;README.txt;AstisenamorjuUrejevalnik.ico" DestinationFolder="$(PublishDir)" />
  </Target>
	<ItemGroup>
		<None Remove="Application Files\**;AstisenamorjuUrejevalnik.exe.manifest;Launcher.manifest" />
		<Content Remove="Application Files\**;AstisenamorjuUrejevalnik.exe.manifest;Launcher.manifest" />
	</ItemGroup>
</Project>
